# ==========================================================
# cnesfy — variáveis de ambiente (copie para .env)
# NENHUM segredo real aqui: só placeholders para você
# preencher na sua máquina.
# ==========================================================

# true = 100% mock (sem Oracle e sem chamada real à Credify)
# false = conecta no Oracle e chama a Credify de produção
USE_MOCK=true

# ─── Banco Oracle (thin mode — opção 1: DSN completo) ───
# Formato: <host>:<porta>/<service_name>  ex.: 10.0.0.5:1521/ORCLPDB1
ORACLE_DSN=

# ─── Banco Oracle (thin mode — opção 2: separado) ───
# (usado apenas se ORACLE_DSN estiver vazio)
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE=

ORACLE_USER=
ORACLE_PASSWORD=

# ─── API Credify (produção) ───
CREDIFY_CLIENT_ID=
CREDIFY_CLIENT_SECRET=
CREDIFY_BASE_URL=https://api.credify.com.br
CREDIFY_AUTH_PATH=/auth
CREDIFY_PF_PATH=/pfpesquisa
CREDIFY_PJ_PATH=/pjpesquisa
CREDIFY_TOKEN_TTL_HORAS=24

# ─── Carteira de tokens (mock) ───
SALDO_INICIAL_TOKENS=1000000
